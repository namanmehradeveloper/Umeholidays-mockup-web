NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
NEXT_PUBLIC_CONTACT_EMAIL=hello@umeholidays.com

# Optional for commercial CKEditor licensing. If omitted, the editor runs in GPL mode.
# NEXT_PUBLIC_CKEDITOR_LICENSE_KEY=your-ckeditor-license-key

# Optional. Backend origin the Next.js server proxies /api/* to (server-side only, never exposed to the browser).
# Leave unset to use the backend that `npm run dev` / `npm run start` runs alongside Next.js on http://127.0.0.1:5000.
# Set it (origin only, no trailing /api) only to use an external backend; it must be present at BUILD time
# because rewrites are baked into the build.
# API_URL=https://<external-backend>.example.com

# Backend secrets (MongoDB, JWT, admin) live in backend/.env — see backend/.env.example

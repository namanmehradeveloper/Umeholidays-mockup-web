{
  "name": "ume-holidays",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "npm run dev --prefix backend",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "start:web": "next start",
    "start:api": "npm start --prefix backend",
    "seed": "npm run seed --prefix backend",
    "postinstall": "npm ci --prefix backend --no-audit --no-fund",
    "lint": "next lint"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.2.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "axios": "^1.12.2",
    "ckeditor5": "^48.5.2",
    "isomorphic-dompurify": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
}

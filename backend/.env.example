# Copy to backend/.env and fill in real values. Never commit backend/.env.

NODE_ENV=development
PORT=5000

# Optional persistent upload directory. Default: backend/uploads
# UPLOAD_DIR=/var/data/ume-holidays/uploads

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Local:  mongodb://127.0.0.1:27017/ume-holidays
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/ume-holidays?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ume-holidays

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Used by `npm run seed` to create the first admin account (only if it does not exist)
ADMIN_NAME=UME Admin
ADMIN_EMAIL=admin@umeholidays.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Transactional email over SMTP (GoDaddy / Titan): enquiry, booking and password-reset emails.
# Server-side only — never prefix these with NEXT_PUBLIC_. On Render, set them as service environment variables.
# Port 465 -> SMTP_SECURE=true (implicit TLS). Port 587 -> SMTP_SECURE=false (STARTTLS).
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-titan-email@your-domain.com
SMTP_PASSWORD=your-titan-email-password
# Sender address; must be the SMTP_USER mailbox (or an alias of it). "UME Holidays <you@your-domain.com>" also works.
MAIL_FROM=your-titan-email@your-domain.com
# Inbox that receives new-enquiry notifications (defaults to ADMIN_EMAIL). Replies go to the customer.
MAIL_TO=your-titan-email@your-domain.com

# Optional fallback provider, used only when SMTP is not configured
# RESEND_API_KEY=

# Cloudinary signed image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Copy to backend/.env and fill in real values. Never commit backend/.env.

NODE_ENV=development
PORT=5000

# Optional persistent upload directory. Default: backend/uploads
# UPLOAD_DIR=/var/data/ume-holidays/uploads

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Local:  mongodb://127.0.0.1:27017/ume-holidays
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/ume-holidays?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ume-holidays

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Used by `npm run seed` to create the first admin account (only if it does not exist)
ADMIN_NAME=UME Admin
ADMIN_EMAIL=admin@umeholidays.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional transactional email via Resend (password reset, enquiry and booking emails)
RESEND_API_KEY=
EMAIL_FROM=UME Holidays <noreply@your-domain.com>

# Cloudinary signed image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

{
  "name": "ume-holidays-api",
  "version": "1.0.0",
  "private": true,
  "description": "UME Holidays REST API (Express + MongoDB)",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/seed/index.js && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/seed/home.js && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/seed/search.js",
    "seed:home": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/seed/home.js",
    "seed:search": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/seed/search.js",
    "seed:planner": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/seed/planner.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0"
  }
}
